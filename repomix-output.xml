<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Unhinged Agent Mock Client</title>
    <style>
        body { background-color: #111; color: #fff; font-family: 'Courier New', monospace; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        canvas { border: 2px solid #333; border-radius: 12px; background-color: #000; margin-bottom: 20px; }
        #status { font-size: 1.2rem; margin-bottom: 10px; color: #888; }
        #transcript { font-size: 1rem; color: #0f0; min-height: 1.5em; text-align: center; max-width: 80%; }
        button { padding: 15px 30px; font-size: 1.2rem; background-color: #222; color: #fff; border: 1px solid #444; border-radius: 8px; cursor: pointer; transition: all 0.2s; }
        button:hover { background-color: #333; border-color: #666; }
        button:disabled { opacity: 0.5; cursor: not-allowed; }
    </style>
</head>
<body>
    <div id="status">Status: Disconnected</div>
    <canvas id="faceCanvas" width="320" height="240"></canvas>
    <div id="transcript">Waiting for input... (Wear headphones to test barge-in!)</div>
    <br>
    <button id="startBtn">Initialize & Connect</button>

    <script>
        const SERVER_URI = "ws://localhost:8000/ws/agent";
        let websocket;
        let audioContext;
        let micProcessor;
        let playbackQueue = [];
        let playbackProcessor;

        const canvas = document.getElementById('faceCanvas');
        const ctx = canvas.getContext('2d');
        const statusEl = document.getElementById('status');
        const transcriptEl = document.getElementById('transcript');
        const startBtn = document.getElementById('startBtn');

        // --- 1. The Face Renderer ---
        function drawFace(state) {
            ctx.fillStyle = '#000';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            let eyeColor = '#fff';
            let eyeSize = 15;

            if (state === 'LISTENING') { eyeColor = '#0096ff'; eyeSize = 20; } 
            else if (state === 'THINKING' || state === 'PROCESSING') { eyeColor = '#ffc800'; } 
            else if (state === 'SPEAKING') { eyeColor = '#00ff64'; eyeSize = 18; }

            ctx.fillStyle = eyeColor;
            ctx.beginPath(); ctx.arc(100, 120, eyeSize, 0, Math.PI * 2); ctx.fill();
            ctx.beginPath(); ctx.arc(220, 120, eyeSize, 0, Math.PI * 2); ctx.fill();
        }
        drawFace('IDLE');

        // --- 2. Connection & Event Handling ---
        startBtn.addEventListener('click', async () => {
            startBtn.disabled = true;
            startBtn.innerText = "Connecting...";

            try {
                websocket = new WebSocket(SERVER_URI);
                websocket.binaryType = "arraybuffer";
                
                // Initialize context and force resume to beat Autoplay policies
                audioContext = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 16000 });
                await audioContext.resume();

                websocket.onopen = async () => {
                    statusEl.innerText = "Status: Connected";
                    statusEl.style.color = "#0f0";
                    startBtn.innerText = "Listening...";
                    await startMicrophone();
                    setupPlayback(); 
                };

                websocket.onmessage = (event) => {
                    if (typeof event.data === 'string') {
                        const data = JSON.parse(event.data);
                        if (data.event === 'STATE_CHANGE') {
                            drawFace(data.state);
                            statusEl.innerText = `Status: ${data.state}`;
                            
                            // INSTANT BARGE-IN CUTOFF
                            if (data.state === 'LISTENING') {
                                playbackQueue = []; 
                            }
                        } else if (data.event === 'TRANSCRIPT') {
                            transcriptEl.innerText = `You: "${data.text}"`;
                        } else if (data.event === 'INTERRUPT') {
                            transcriptEl.innerText = "[Interrupted]";
                            playbackQueue = []; 
                        }
                    } else {
                        queueAudioChunk(event.data);
                    }
                };

                websocket.onclose = () => {
                    statusEl.innerText = "Status: Disconnected";
                    statusEl.style.color = "#f00";
                    startBtn.disabled = false;
                    startBtn.innerText = "Reconnect";
                    drawFace('IDLE');
                    playbackQueue = [];
                };
            } catch (err) {
                console.error(err);
                alert("Failed to connect. Is the FastAPI server running?");
                startBtn.disabled = false;
            }
        });

        // --- 3. Microphone Streaming ---
        async function startMicrophone() {
            const stream = await navigator.mediaDevices.getUserMedia({ 
                audio: { sampleRate: 16000, channelCount: 1, echoCancellation: true, noiseSuppression: true } 
            });
            const source = audioContext.createMediaStreamSource(stream);
            micProcessor = audioContext.createScriptProcessor(1024, 1, 1);
            
            micProcessor.onaudioprocess = (e) => {
                if (websocket.readyState === WebSocket.OPEN) {
                    const inputData = e.inputBuffer.getChannelData(0);
                    const int16Data = new Int16Array(inputData.length);
                    for (let i = 0; i < inputData.length; i++) {
                        const s = Math.max(-1, Math.min(1, inputData[i]));
                        int16Data[i] = s < 0 ? s * 0x8000 : s * 0x7FFF;
                    }
                    websocket.send(int16Data.buffer);
                }
            };
            source.connect(micProcessor);
            micProcessor.connect(audioContext.destination);
        }

        // --- 4. Gapless, Interruptible Playback Queue ---
        function setupPlayback() {
            // CRITICAL FIX: 0 input channels, 1 output channel
            playbackProcessor = audioContext.createScriptProcessor(2048, 0, 1);
            playbackProcessor.onaudioprocess = (e) => {
                const output = e.outputBuffer.getChannelData(0);
                let samplesWritten = 0;
                
                while (samplesWritten < 2048 && playbackQueue.length > 0) {
                    const chunk = playbackQueue[0];
                    const samplesToCopy = Math.min(2048 - samplesWritten, chunk.length - chunk.offset);
                    
                    for (let i = 0; i < samplesToCopy; i++) {
                        output[samplesWritten + i] = chunk.data[chunk.offset + i];
                    }
                    
                    chunk.offset += samplesToCopy;
                    samplesWritten += samplesToCopy;
                    
                    if (chunk.offset >= chunk.length) {
                        playbackQueue.shift();
                    }
                }
                
                // Fill remaining with silence
                for (let i = samplesWritten; i < 2048; i++) {
                    output[i] = 0;
                }
            };
            playbackProcessor.connect(audioContext.destination);
        }

        function queueAudioChunk(arrayBuffer) {
            // CRITICAL FIX: Ensure byte alignment before casting
            if (arrayBuffer.byteLength % 2 !== 0) {
                console.warn("Received unaligned audio chunk, discarding.");
                return;
            }

            const int16Data = new Int16Array(arrayBuffer);
            const float32Data = new Float32Array(int16Data.length);
            for (let i = 0; i < int16Data.length; i++) {
                float32Data[i] = int16Data[i] / 32768.0;
            }
            playbackQueue.push({ data: float32Data, offset: 0, length: float32Data.length });
        }
    </script>
</body>
</html>
